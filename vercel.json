{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "nextjs"
    },
    "backend": {
      "root": ".",
      "entrypoint": "api/index.py",
      "includeFiles": [
        "frontend/public/data/stats_batters.json",
        "frontend/public/data/stats_bowlers.json",
        "frontend/public/data/stats_h2h.json"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
